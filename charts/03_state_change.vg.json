{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Change in the number of government school students in each state and territory between 2020 and 2025, in headcount rather than share. The dark grey marker shows where that state's government system would have landed had it grown at the same rate as the state's whole student population, and the dashed line draws the gap between the two, which is the part of the move that is a sector shift rather than population growth.",
  "width": "container",
  "height": 320,
  "padding": {
    "top": 26,
    "left": 4,
    "right": 4,
    "bottom": 4
  },
  "data": {
    "url": "data/processed/state_change.csv",
    "format": {
      "type": "csv",
      "parse": {
        "gov_share_2020": "number",
        "gov_share_2025": "number",
        "change_pp": "number",
        "gov_enrolments_2020": "number",
        "gov_enrolments_2025": "number",
        "gov_pct_change": "number",
        "total_pct_change": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.gov_enrolments_2025 - datum.gov_enrolments_2020",
      "as": "gov_change"
    },
    {
      "calculate": "datum.gov_enrolments_2020 * datum.total_pct_change / 100",
      "as": "expected_change"
    },
    {
      "calculate": "datum.gov_change - datum.expected_change",
      "as": "shortfall"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "gov_change",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "labelColor": "#0b0b0b",
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "gov_change",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          -44000,
          44000
        ]
      },
      "axis": {
        "labels": false,
        "ticks": false,
        "domain": false,
        "grid": false
      }
    }
  },
  "layer": [
    {
      "description": "The gap itself, drawn as a dashed line from what happened to what population growth alone would have given. Sits under the bar, so only the shortfall shows.",
      "mark": {
        "type": "rule",
        "color": "#8f8b80",
        "strokeWidth": 1.4,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "gov_change",
          "type": "quantitative"
        },
        "x2": {
          "field": "expected_change"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": 18,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.gov_change < 0",
            "value": "#a8322c"
          },
          "value": "#7b3fa0"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "gov_enrolments_2020",
            "title": "Government students 2020",
            "format": ",.0f"
          },
          {
            "field": "gov_enrolments_2025",
            "title": "Government students 2025",
            "format": ",.0f"
          },
          {
            "field": "gov_change",
            "type": "quantitative",
            "title": "Change",
            "format": "+,.0f"
          },
          {
            "field": "expected_change",
            "type": "quantitative",
            "title": "Change if it grew with the state",
            "format": "+,.0f"
          },
          {
            "field": "shortfall",
            "type": "quantitative",
            "title": "Gap",
            "format": "+,.0f"
          },
          {
            "field": "gov_pct_change",
            "title": "Government students, change",
            "format": "+.1f"
          },
          {
            "field": "total_pct_change",
            "title": "All students, change",
            "format": "+.1f"
          },
          {
            "field": "change_pp",
            "title": "Change in government share (pts)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "description": "Where government enrolments would have landed had they simply tracked the state's overall student growth.",
      "mark": {
        "type": "tick",
        "thickness": 2.5,
        "size": 30,
        "color": "#3f3d38"
      },
      "encoding": {
        "x": {
          "field": "expected_change",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "expected_change",
            "type": "quantitative",
            "title": "If government had tracked total growth",
            "format": "+,.0f"
          },
          {
            "field": "gov_change",
            "type": "quantitative",
            "title": "What actually happened",
            "format": "+,.0f"
          },
          {
            "field": "shortfall",
            "type": "quantitative",
            "title": "Gap",
            "format": "+,.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.gov_change < 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "align": "right",
        "dx": -9
      },
      "encoding": {
        "x": {
          "field": "gov_change",
          "type": "quantitative"
        },
        "text": {
          "field": "gov_change",
          "type": "quantitative",
          "format": "+,.0f"
        },
        "color": {
          "value": "#52514e"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.gov_change >= 0 && (datum.expected_change - datum.gov_change) >= 7000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "align": "left",
        "dx": 9
      },
      "encoding": {
        "x": {
          "field": "gov_change",
          "type": "quantitative"
        },
        "text": {
          "field": "gov_change",
          "type": "quantitative",
          "format": "+,.0f"
        },
        "color": {
          "value": "#52514e"
        }
      },
      "description": "Value label for a growing state, set outside the bar. The reference marker is far enough away to leave room."
    },
    {
      "transform": [
        {
          "filter": "datum.gov_change >= 0 && (datum.expected_change - datum.gov_change) < 7000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "align": "right",
        "dx": -9
      },
      "encoding": {
        "x": {
          "field": "gov_change",
          "type": "quantitative"
        },
        "text": {
          "field": "gov_change",
          "type": "quantitative",
          "format": "+,.0f"
        },
        "color": {
          "value": "#52514e"
        }
      },
      "description": "Same label where the reference marker sits almost on top of the bar end, as it does for the ACT. Flipped to the empty side of the bar so the two do not print over each other."
    },
    {
      "description": "Zero line. Uses the inherited data so it adds no extra category to the axis.",
      "mark": {
        "type": "rule",
        "color": "#52514e",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "description": "Names the grey marker once, on the top row, so the reader does not have to work out what it is from the caption.",
      "transform": [
        {
          "filter": "datum.state === 'NSW'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 7,
        "dy": -19,
        "fontSize": 10.5,
        "fontWeight": 600,
        "font": "Archivo, Helvetica Neue, Arial, sans-serif",
        "color": "#3f3d38",
        "text": "↓ Where it would be if it grew with the state"
      },
      "encoding": {
        "x": {
          "field": "expected_change",
          "type": "quantitative"
        }
      }
    }
  ]
}
