{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Government share of enrolments at each year level, every year from 2009 to 2025, shown as change in percentage points against that year level's own 2009 share. The grid answers when the shift started and which year levels moved first, rather than restating the five-year change shown in the previous figure.",
  "width": "container",
  "height": 392,
  "data": {
    "url": "data/processed/grade_share_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "grade_order": "number",
        "year": "number",
        "gov_students": "number",
        "total_students": "number",
        "gov_share": "number",
        "share_base": "number",
        "pp_change": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "grade",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "grade_order",
        "op": "min"
      },
      "axis": {
        "labelFontSize": 11.5,
        "labelFontWeight": 500,
        "labelColor": "#16150f",
        "domain": false,
        "ticks": false,
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#eeebe3",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "pp_change",
          "type": "quantitative",
          "title": "Change in government share since 2009 (percentage points)",
          "scale": {
            "type": "linear",
            "domain": [
              -6.5,
              -4.5,
              -2.5,
              -1,
              0,
              1,
              2.5
            ],
            "range": [
              "#8c2823",
              "#ab3f36",
              "#c9776d",
              "#e3b4ab",
              "#efe9df",
              "#b9a7d4",
              "#7b3fa0"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "type": "gradient",
            "gradientLength": 230,
            "gradientThickness": 11,
            "values": [
              -6,
              -4,
              -2,
              0,
              2
            ],
            "format": "+d",
            "titleLimit": 420,
            "offset": 6
          }
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Year level"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "gov_share",
            "title": "In a government school (%)",
            "format": ".1f"
          },
          {
            "field": "share_base",
            "title": "Same year level in 2009 (%)",
            "format": ".1f"
          },
          {
            "field": "pp_change",
            "title": "Change since 2009 (pts)",
            "format": "+.1f"
          },
          {
            "field": "gov_students",
            "title": "Government students",
            "format": ",.0f"
          },
          {
            "field": "total_students",
            "title": "All students",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "description": "2020, where every row turns. Drawn on the left edge of the 2020 column.",
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.grade_order === 0"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#16150f",
        "strokeWidth": 1.5,
        "y": -8,
        "y2": 392
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "bandPosition": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.grade_order === 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#16150f"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "bandPosition": 0
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "2020"
        }
      }
    }
  ]
}
