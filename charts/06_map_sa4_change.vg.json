{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of the change in the government share of enrolments between 2020 and 2025, across the 88 ABS Statistical Area Level 4 regions. Albers equal-area conic projection.",
  "title": {
    "text": "The shift is sharpest outside the big cities",
    "subtitle": [
      "Change in the share of students attending a government school, 2020 to 2025, by region.",
      "Sources: ACARA School Profile and School Location; ABS Statistical Areas Level 4, 2021."
    ]
  },
  "width": "container",
  "height": 470,
  "projection": {
    "type": "albers",
    "rotate": [
      -134,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "description": "Faint land underneath, so a region with no schools still reads as land.",
      "data": {
        "url": "maps/au_sa4_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0efec",
        "stroke": "#fcfcfb",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "maps/au_sa4_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "sa4"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa4_code",
          "from": {
            "data": {
              "url": "data/processed/sa4_change.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "gov_share_2020": "number",
                  "gov_share_2025": "number",
                  "change_pp": "number",
                  "gov_pct_change": "number",
                  "total_pct_change": "number",
                  "students_2025": "number",
                  "gov_students_2025": "number"
                }
              }
            },
            "key": "sa4_code",
            "fields": [
              "sa4_name",
              "state",
              "change_pp",
              "gov_share_2020",
              "gov_share_2025",
              "students_2025"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fcfcfb",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "change_pp",
          "type": "quantitative",
          "title": "Change in government share, 2020 to 2025 (percentage points)",
          "scale": {
            "type": "threshold",
            "domain": [
              -6,
              -3,
              -1,
              1,
              3,
              6
            ],
            "range": [
              "#9c2c2b",
              "#e34948",
              "#f0a9a8",
              "#f0efec",
              "#b7d3f6",
              "#5598e7",
              "#184f95"
            ]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "legendX": 10,
            "legendY": 398,
            "titleLimit": 420,
            "symbolType": "square",
            "symbolSize": 120
          }
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "gov_share_2020",
            "title": "Government share 2020",
            "format": ".1f"
          },
          {
            "field": "gov_share_2025",
            "title": "Government share 2025",
            "format": ".1f"
          },
          {
            "field": "change_pp",
            "title": "Change (pts)",
            "format": "+.1f"
          },
          {
            "field": "students_2025",
            "title": "Students 2025",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "description": "State outlines over the top for orientation.",
      "data": {
        "url": "maps/au_sa4_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#898781",
        "strokeWidth": 0.7
      }
    }
  ]
}
